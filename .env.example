# ---- Backend ----
# Server-side only. The browser never calls the API directly.
API_BASE_URL=http://localhost:8000/api/v1

# ---- Auth.js ----
# MUST be byte-identical to AUTH_JWT_SECRET in backend/.env.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Password-less sign-in so the app can be exercised before Google/LinkedIn are
# registered. Requires a non-production build as well as this flag. Never set
# this in a deployed environment.
ALLOW_DEV_SIGNIN=false

# Claims the backend validates.
AUTH_JWT_ISSUER=gradportal-web
AUTH_JWT_AUDIENCE=gradportal-api

# ---- Google ----
# Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Enable the Gmail API, and add the gmail.send scope on the OAuth consent screen.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- LinkedIn ----
# developer.linkedin.com → your app → Auth
# Redirect URL: http://localhost:3000/api/auth/callback/linkedin
# Products: "Sign In with LinkedIn using OpenID Connect"
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# ---- AI services (server-side only; the browser never calls these) ----
DOC_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
EVAL_SERVICE_URL=http://localhost:8003
VOICE_SERVICE_URL=http://localhost:8004

# Browser-visible origin for admin-uploaded media served by core-api.
NEXT_PUBLIC_CORE_ORIGIN=http://localhost:8000
